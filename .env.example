# Discord bot posting to the free games channel(s)
DISCORD_TOKEN=
DISCORD_CHANNELS=123456789012345678,234567890123456789

# Gmail sender (use an app password, not the account password)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=

# Comma-separated recipients of the free games email
RECIPIENTS=you+games@gmail.com
# Receives the traceback when a run fails
ERROR_EMAIL=you@gmail.com

# Optional
# RUN_HOURS=7-22                # --loop checks at the top of each of these hours
# TIMEZONE=Europe/Zagreb
# STATE_FILE=state/seen.txt     # the Docker image sets /app/scraped/seen.txt
